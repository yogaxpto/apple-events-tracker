root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[{*.yml,*.yaml,*.json,*.toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# The iCalendar feed is generated with CRLF line endings (RFC 5545) — leave it alone.
[*.ics]
end_of_line = crlf
insert_final_newline = false
trim_trailing_whitespace = false
