<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="Unofficial, auto-updating tracker for Apple special events. Subscribe once to a calendar feed and never miss a keynote." />
  <meta name="theme-color" content="#05060a" />
  <meta property="og:title" content="Apple Events Tracker (Unofficial)" />
  <meta property="og:description" content="Subscribe once to a calendar feed and never miss an Apple keynote." />
  <meta property="og:type" content="website" />
  <title>Apple Events Tracker (Unofficial)</title>
  <link rel="stylesheet" href="assets/style.css" />
</head>
<body>
  <div class="aurora" aria-hidden="true">
    <span class="aurora__blob aurora__blob--1"></span>
    <span class="aurora__blob aurora__blob--2"></span>
    <span class="aurora__blob aurora__blob--3"></span>
  </div>

  <header class="topbar">
    <a class="brand" href="#top">
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" focusable="false">
          <path d="M17.05 12.94c-.02-2.27 1.85-3.36 1.94-3.41-1.06-1.55-2.71-1.76-3.29-1.78-1.4-.14-2.73.82-3.44.82-.71 0-1.8-.8-2.96-.78-1.52.02-2.93.88-3.71 2.24-1.58 2.74-.4 6.8 1.13 9.02.75 1.09 1.64 2.31 2.81 2.27 1.13-.05 1.56-.73 2.92-.73 1.36 0 1.75.73 2.94.71 1.21-.02 1.98-1.11 2.72-2.21.86-1.27 1.21-2.5 1.23-2.56-.03-.01-2.36-.91-2.38-3.62zM14.8 6.2c.62-.76 1.04-1.8.93-2.85-.9.04-1.99.6-2.63 1.35-.57.67-1.08 1.74-.94 2.76 1 .08 2.02-.51 2.64-1.26z"/>
        </svg>
      </span>
      <span class="brand__name">Apple Events <span class="brand__sub">Tracker</span></span>
    </a>
    <a class="topbar__cta" href="{{ webcal_url }}">Subscribe</a>
  </header>

  <main id="top">
    <!-- Hero ------------------------------------------------------------------>
    <section class="hero" aria-labelledby="upcoming-heading">
      <p class="eyebrow"><span class="dot" aria-hidden="true"></span> Unofficial event tracker</p>
      {% if upcoming %}
        {% set next_event = upcoming[0] %}
        <h1 id="upcoming-heading" class="hero__title">{{ next_event.title }}</h1>
        <p class="hero__date">
          <time datetime="{{ next_event.start }}">{{ next_event | event_date }}</time>
        </p>
        {% if next_event.description %}
          <p class="hero__blurb">{{ next_event.description }}</p>
        {% endif %}

        {% if not next_event.all_day %}
          <div class="countdown" data-countdown="{{ next_event.start }}" hidden>
            <div class="countdown__cell"><span class="countdown__num" data-unit="days">0</span><span class="countdown__label">days</span></div>
            <div class="countdown__cell"><span class="countdown__num" data-unit="hours">0</span><span class="countdown__label">hrs</span></div>
            <div class="countdown__cell"><span class="countdown__num" data-unit="minutes">0</span><span class="countdown__label">min</span></div>
            <div class="countdown__cell"><span class="countdown__num" data-unit="seconds">0</span><span class="countdown__label">sec</span></div>
          </div>
        {% endif %}

        <div class="hero__actions">
          <a class="btn btn--primary" href="{{ webcal_url }}">Add to calendar</a>
          {% if next_event.watch_url %}
            <a class="btn btn--ghost" href="{{ next_event.watch_url }}">
              <span class="btn__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
              </span>
              Watch the event
            </a>
          {% endif %}
        </div>
      {% else %}
        <h1 id="upcoming-heading" class="hero__title hero__title--quiet">Nothing on the calendar&nbsp;yet</h1>
        <p class="hero__blurb hero-empty">No upcoming Apple event announced right now. Subscribe below and the next one will appear automatically.</p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="{{ webcal_url }}">Subscribe for the next one</a>
        </div>
      {% endif %}
    </section>

    <!-- Subscribe ------------------------------------------------------------->
    <section class="subscribe" aria-labelledby="subscribe-heading">
      <div class="section-head">
        <h2 id="subscribe-heading">Subscribe once, stay current</h2>
        <p class="section-sub">Add the feed to any calendar app. New and updated events sync automatically — no app, no account.</p>
      </div>
      <ul class="cards subscribe__cards">
        <li class="card card--link">
          <a href="{{ webcal_url }}">
            <span class="card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4M12 13v4M10 15h4"/></svg>
            </span>
            <span class="card__body">
              <span class="card__title">Apple Calendar &amp; more</span>
              <span class="card__desc">One-tap <code>webcal://</code> subscribe</span>
            </span>
            <span class="card__chev" aria-hidden="true">→</span>
          </a>
        </li>
        <li class="card card--link">
          <a href="{{ google_calendar_url }}">
            <span class="card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg>
            </span>
            <span class="card__body">
              <span class="card__title">Google Calendar</span>
              <span class="card__desc">Add the feed to your Google account</span>
            </span>
            <span class="card__chev" aria-hidden="true">→</span>
          </a>
        </li>
        <li class="card card--link">
          <a href="{{ feed_url }}">
            <span class="card__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12m0 0l-4-4m4 4l4-4M5 21h14"/></svg>
            </span>
            <span class="card__body">
              <span class="card__title">Download .ics</span>
              <span class="card__desc">Raw iCalendar file for any app</span>
            </span>
            <span class="card__chev" aria-hidden="true">→</span>
          </a>
        </li>
      </ul>
    </section>

    <!-- Past events ----------------------------------------------------------->
    <section class="past" aria-labelledby="past-heading">
      <div class="section-head">
        <h2 id="past-heading">Recent Apple Events</h2>
        <p class="section-sub">A running archive, kept up to date automatically.</p>
      </div>
      {% if past %}
        <ul class="cards past__grid">
          {% for event in past %}
            <li class="card past-card">
              <span class="badge badge--{{ event.kind }}">
                {%- if event.kind == 'wwdc' -%}WWDC
                {%- elif event.kind == 'special-event' -%}Special Event
                {%- else -%}Event{%- endif -%}
              </span>
              <h3 class="past-card__title">{{ event.title }}</h3>
              <p class="past-card__date">
                <time datetime="{{ event.start }}">{{ event | event_date }}</time>
              </p>
              {% if event.description %}
                <p class="past-card__blurb">{{ event.description }}</p>
              {% endif %}
              {% if event.watch_url %}
                <a class="past-card__watch" href="{{ event.watch_url }}">
                  <span aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                  </span>
                  Watch
                </a>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="empty-note">No past events recorded yet.</p>
      {% endif %}
    </section>
  </main>

  <footer class="site-footer">
    <p class="disclaimer">{{ disclaimer }}</p>
    <nav class="footer-links" aria-label="Footer">
      <a href="{{ source_url }}">Official Apple Events page</a>
      <span aria-hidden="true">·</span>
      <a href="{{ repo_url }}">Source code</a>
    </nav>
    <p class="last-updated">
      Last updated
      <time id="generated-at" datetime="{{ generated_at }}">{{ generated_at }}</time>
      UTC<span id="local-time"></span>
    </p>
  </footer>

  <script>
    // Progressive enhancement only (WEB-1, WEB-4): no tracking, no network calls.
    // The page is fully usable with JavaScript disabled.
    (function () {
      // 1) "Last updated" in the viewer's local time.
      var el = document.getElementById("generated-at");
      var local = document.getElementById("local-time");
      if (el && local) {
        var d = new Date(el.getAttribute("datetime"));
        if (!isNaN(d.getTime())) {
          local.textContent = " (" + d.toLocaleString() + " your time)";
        }
      }

      // 2) Live countdown to the upcoming event.
      var cd = document.querySelector("[data-countdown]");
      if (!cd) return;
      var target = new Date(cd.getAttribute("data-countdown"));
      if (isNaN(target.getTime())) return;
      var units = {
        days: cd.querySelector('[data-unit="days"]'),
        hours: cd.querySelector('[data-unit="hours"]'),
        minutes: cd.querySelector('[data-unit="minutes"]'),
        seconds: cd.querySelector('[data-unit="seconds"]')
      };
      function pad(n) { return (n < 10 ? "0" : "") + n; }
      function tick() {
        var diff = Math.floor((target.getTime() - Date.now()) / 1000);
        if (diff <= 0) {
          cd.setAttribute("data-live", "now");
          units.days.textContent = units.hours.textContent =
            units.minutes.textContent = units.seconds.textContent = "00";
          clearInterval(timer);
          return;
        }
        units.days.textContent = Math.floor(diff / 86400);
        units.hours.textContent = pad(Math.floor((diff % 86400) / 3600));
        units.minutes.textContent = pad(Math.floor((diff % 3600) / 60));
        units.seconds.textContent = pad(diff % 60);
      }
      cd.hidden = false;
      tick();
      var timer = setInterval(tick, 1000);
    })();
  </script>
</body>
</html>
