{
  "version": "2.0.0",
  "tasks": [
    {
      // Sync project deps + the editable package into a workspace-local .venv before
      // debugging. The devcontainer's default uv environment (/usr/local) is not
      // writable by the 'vscode' user, so we target ${workspaceFolder}/.venv instead
      // (already gitignored). Fast no-op once in sync.
      "label": "uv sync",
      "type": "shell",
      "command": "uv sync",
      "options": {
        "env": { "UV_PROJECT_ENVIRONMENT": "${workspaceFolder}/.venv" }
      },
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared", "clear": false }
    }
  ]
}
