{
  // Debug configurations. The "uv sync" preLaunchTask installs deps + the editable
  // package into ${workspaceFolder}/.venv (the /usr/local env is not writable here),
  // and each config launches that .venv interpreter explicitly so debugpy always has
  // the project available. Breakpoints map to src/ via the editable install.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Preview server",
      "type": "debugpy",
      "request": "launch",
      "module": "apple_events_tracker.preview",
      "args": ["--port", "8000"],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": false,
      "preLaunchTask": "uv sync",
      "env": {
        "GITHUB_REPOSITORY": "yogaxpto/apple-events-tracker",
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "Tracker (offline fixture, dry-run)",
      "type": "debugpy",
      "request": "launch",
      "module": "apple_events_tracker.cli",
      "args": [
        "--from-file",
        "tests/fixtures/apple-events-recent-gallery.html",
        "--dry-run",
        "--verbose"
      ],
      "cwd": "${workspaceFolder}",
      "python": "${workspaceFolder}/.venv/bin/python",
      "console": "integratedTerminal",
      "justMyCode": false,
      "preLaunchTask": "uv sync",
      "env": {
        "GITHUB_REPOSITORY": "yogaxpto/apple-events-tracker"
      }
    }
  ]
}
