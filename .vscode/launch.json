{
  // Debug configurations. Dependencies and the editable project live in the
  // container's system Python (/usr/local) — installed at image build + container
  // create — so each config just uses the default interpreter; no .venv, no
  // preLaunchTask. Breakpoints map to src/ via the editable install.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Preview server",
      "type": "debugpy",
      "request": "launch",
      "module": "apple_events_tracker.preview",
      "args": ["--port", "8000"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "GITHUB_REPOSITORY": "yogaxpto/apple-events-tracker",
        "PYTHONUNBUFFERED": "1"
      }
    },
    {
      "name": "Tracker (offline fixture, dry-run)",
      "type": "debugpy",
      "request": "launch",
      "module": "apple_events_tracker.cli",
      "args": [
        "--from-file",
        "tests/fixtures/apple-events-recent-gallery.html",
        "--dry-run",
        "--verbose"
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "GITHUB_REPOSITORY": "yogaxpto/apple-events-tracker"
      }
    }
  ]
}
